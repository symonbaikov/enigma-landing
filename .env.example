VITE_DIRECTUS_URL=https://your-directus-instance.com
VITE_DIRECTUS_TOKEN=your-static-token

# Enigma platform (separate repo, runs on app.enigma.com).
# Used by Hero free-audit form, demo launch buttons, and Login/Sign up buttons.
VITE_PLATFORM_API=https://app.enigma.com
VITE_PLATFORM_URL=https://app.enigma.com

# ----- PostHog (click tracking) -----
# Leave the key empty and nothing is sent — local dev stays out of the numbers.
# EU cloud by default: the waitlist stores an email address.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
